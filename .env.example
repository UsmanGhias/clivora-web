# Public (safe in browser bundle)
NEXT_PUBLIC_SITE_URL=https://clivora.io
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-development-anon-key

# Server-only — paste from Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Staging (Vercel backup) should use:
# NEXT_PUBLIC_SITE_URL=https://clivora.io

# Optional — SafePay (website /pro hosted checkout). Never commit real values.
SAFEPAY_SECRET_KEY=
SAFEPAY_API_KEY=
SAFEPAY_PUBLIC_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENV=production
SAFEPAY_CURRENCY=USD

# Optional — Stripe (disabled unless STRIPE_ENABLED=true)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_PLUS=

# Optional — Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — AI ask route
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — Meilisearch / automation
MEILI_HOST=
MEILI_KEY=
AUTOMATION_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=

# Optional — Odoo (admin-only). Prefer API keys — never commit real values.
ODOO_SYNC_ENABLED=false
ODOO_MAIN_URL=
ODOO_MAIN_DB=
ODOO_MAIN_USERNAME=
ODOO_MAIN_API_KEY=
ODOO_SOCIAL_URL=
ODOO_SOCIAL_DB=
ODOO_SOCIAL_USERNAME=
ODOO_SOCIAL_API_KEY=
# Legacy fallback for main only.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# Optional — only if app code starts reading EMAIL_FROM
# EMAIL_FROM=contact@clivora.io
